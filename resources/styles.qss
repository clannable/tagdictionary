QMainWindow > QFrame > QLineEdit {
    border-radius: 4px;
    padding: 4px;
    background: palette(base);
    border: 1px solid palette(mid);
}


QPushButton[flat="false"] {
    height: 28px;
}

MediaDisplay QPushButton[flat="false"] {
    width: 40px;
}

QDialog QPushButton {
    min-width: 3em;
    padding-left: 0.5em;
    padding-right: 0.5em;
    font-weight: 600;
}

QToolButton {
    width: 25px;
    height: 25px;
}

QPushButton[flat="false"], QToolButton {
    border-radius: 4px;
    border: 1px solid #b9b9b9;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #f9f9f9, stop: 1 #e5e5e5);
    color: #3a3a3a;
}

QPushButton[flat="false"]:hover, QToolButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #c9c9c9, stop: 1 #a5a5a5);
    border-color: #8f8f8f;
}

QPushButton[flat="false"]:pressed, QToolButton:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #a9a9a9, stop: 1 #959595);
    border-color: #8f8f8f;
}

QPushButton[flat="false"]:disabled, QToolButton:disabled {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #eaeaea, stop: 1 #c5c5c5);
    border-color: #bebebe;
    color: #bebebe;
}

QPushButton#saveButton {
    border: 1px solid #b9b9b9;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #247ccf, stop: 1 #1c62a3);
    color: #c5c5c5;
}

QPushButton#saveButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #1f6bb3, stop: 1 #18578d);
    border-color: #8f8f8f;
}

QPushButton#saveButton:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #18578d, stop: 1 #1f6bb3);
    border-color: #8f8f8f;
}

QPushButton#saveButton:disabled {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #eaeaea, stop: 1 #c5c5c5);
    border-color: #bebebe;
    color: #bebebe;
}

TagEditor QLineEdit:disabled {
    border: none;
    padding-bottom: 1px;
}

TagEditor QLineEdit {
    height: 24px;
    border: 1px solid #6a6a6a;
    background-color: rgba(255,255,255,0);
    color: #3d3d3d;
    padding-bottom: 0;
}

TagEditor QToolButton:disabled {
    border: none;
    color: unset;
}

TagEditor .QTextEdit {
    background-color: white;
}

TagEditor .QTextBrowser {
    background: transparent;
}

TagEditor QToolButton {
    background: rgba(0, 0, 0, 0);
    border: 1px solid #6a6a6a;
    border-radius: 2px;
}

TagEditor QToolButton:hover {
    background: rgba(0,0,0,50);
}

TagEditor QToolButton:pressed {
    background: rgba(0,0,0, 80);
    border: 1px solid #959595;
}

TagList {
    background: transparent;
    border: 1px solid transparent;
    height: 107px;
    font: 350 10pt 'Segoe UI';
}

TagEditor QTextEdit QScrollBar:vertical, TagList QScrollbar:vertical{
    width: 6px;
    border: none;
    background: transparent;
}

TagEditor QTextEdit QScrollBar::handle:vertical, TagList QScrollbar::handle:vertical {
    width: 6px;
    border-radius: 3px;
    background: #aaaaaa;
}

TagEditor .QLabel {
    font: 700 12pt "Segoe UI";
}

VideoPlayer QSlider::groove:horizontal {
    height: 5px;
    background: #ffffff;
    border: none;
}

VideoPlayer QSlider::handle:horizontal {
    width: 12px;
    margin: -8px 0;
    border-radius: 4px;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #f5f5f5, stop: 1 #e2e2e2);
    border: 1px solid #5c5c5c;
}

VideoPlayer QSlider::handle:horizontal::hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #e5e5e5, stop: 1 #d2d2d2);
}

VideoPlayer QSlider::handle:horizontal::pressed{
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #c5c5c5, stop: 1 #b2b2b2);
}

VideoPlayer QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #014fb5, stop:1 #0089ce);
    border: 1px solid #b1b1b1;
    height: 5px;
    border-radius: 2px;
}

VideoPlayer QSlider::sub-page:horizontal::disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0  #b9b9b9, stop:1 #a4a4a4);
}

VideoPlayer QSlider::add-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0  #d9d9d9, stop:1 #e4e4e4);
    border: 1px solid #b1b1b1;
    height: 5px;
    border-radius: 2px;
}

VideoPlayer QSlider#volumeSlider::handle:horizontal {
    width: 10px;
    margin: -5px 0;
}

VideoPlayer QSlider#progressSlider::handle:horizontal {
    width: 12px;
    margin: -8px 0;
}

FileNav #numbers QToolButton {
    background: transparent;
    border-color: #b1b1b1;
    font-weight: 700;
    border-radius: 13px;
    height: 30px;
}

FileNav #numbers QToolButton::disabled {
    background-color: rgba(74, 157, 208, 125);
    border-color: rgba(74, 157, 208, 125);
    color: black;
}

FileNav #numbers QToolButton::hover {
    border-color: rgb(74, 157, 208);
}

FileNav #numbers QToolButton:pressed {
    background-color: rgba(74, 157, 208, 125);
}

FileNav #previous, FileNav #next {
    border-radius: 12px;
    border-color: rgba(74, 157, 208, 125);
    background-color: transparent;
}

FileNav #previous::disabled, FileNav #next::disabled {
    border-color: #b1b1b1;
}

FileNav #previous::enabled::hover, FileNav #next::enabled::hover {
    border-color: rgb(74, 157, 208);
}

FileNav #previous:pressed, FileNav #next:pressed {
    background-color: rgba(74, 157, 208, 75);
}
